import "./style.css";
import { statusLabel, priorityLabel } from "#app/shared/services/tracker";

export interface Person {
  id: string;
  name: string;
}

export function initials(name: string): string {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0].toUpperCase()).join("");
}

/** Hashes the name, not the id, so each person keeps their color across reseeds. */
function hue(name: string): string {
  let sum = 0;
  for (let i = 0; i < name.length; i++) {
    sum = (sum + name.charCodeAt(i)) % 6;
  }

  return `is-hue-${sum}`;
}

<StatusIcon (status: string)>
  <svg class={`status-icon is-${status}`} width="14" height="14" viewBox="0 0 14 14" role="img" aria-label={statusLabel(status)}>
    <circle e:if={status === "backlog"} cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2"/>
    <circle e:if={status !== "backlog"} cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path e:if={status === "in_progress"} d="M7 3.5 A3.5 3.5 0 0 1 7 10.5 Z" fill="currentColor"/>
    <path e:if={status === "in_review"} d="M7 3.5 A3.5 3.5 0 1 1 3.5 7 L7 7 Z" fill="currentColor"/>
    <circle e:if={status === "done"} cx="7" cy="7" r="5.5" fill="currentColor"/>
    <path e:if={status === "done"} d="M4.6 7.2 L6.3 8.8 L9.4 5.4" fill="none" stroke="var(--bg)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</StatusIcon>

<PriorityIcon (priority: string)>
  <svg class={`priority-icon is-${priority}`} width="14" height="14" viewBox="0 0 14 14" role="img" aria-label={`${priorityLabel(priority)} priority`}>
    <g e:if={priority === "urgent"}>
      <rect x="1" y="1" width="12" height="12" rx="3" fill="currentColor"/>
      <rect x="6.25" y="3.5" width="1.5" height="4.5" rx="0.75" fill="var(--bg)"/>
      <rect x="6.25" y="9.25" width="1.5" height="1.5" rx="0.75" fill="var(--bg)"/>
    </g>
    <g e:else fill="currentColor">
      <rect x="1.5" y="8" width="2.5" height="4" rx="0.8"/>
      <rect class={priority === "low" ? "is-off" : ""} x="5.75" y="5" width="2.5" height="7" rx="0.8"/>
      <rect class={priority !== "high" ? "is-off" : ""} x="10" y="2" width="2.5" height="10" rx="0.8"/>
    </g>
  </svg>
</PriorityIcon>

<Avatar (person: Person | undefined, large: boolean = false)>
  <span e:if={person} class={["avatar", hue(person!.name), large && "is-lg"]} title={person!.name}>{initials(person!.name)}</span>
  <span e:else class={["avatar", "is-empty", large && "is-lg"]} title="Unassigned"></span>
</Avatar>

<LabelList (labels: string[])>
  <ul e:if={labels.length > 0} class="label-list cluster is-xs">
    <li e:for={label of labels.map((name) => ({ id: name, name }))}><span class="pill label-pill">{label.name}</span></li>
  </ul>
</LabelList>
