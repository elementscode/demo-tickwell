import "./style.css";
import { redirect } from "@elements/app";
import { User, signout } from "#app/shared/services/auth";

function onSignout() {
  signout();
  redirect("/signin");
}

<AppShell (user: User, section: string)>
  <div class="app">
    <header class="app-shell-bar">
      <div class="app-shell-inner row">
        <div class="row gap-6">
          <a class="app-shell-brand row" href="/">
            <svg class="app-shell-mark" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
              <rect width="24" height="24" rx="6" fill="currentColor"/>
              <path d="M6.5 12.5 L10.5 16.5 L17.5 8" stroke="var(--accent-ink)" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            tickwell
          </a>
          <nav class="app-shell-nav row gap-1" aria-label="Main">
            <a href="/" class={[section === "projects" && "is-active"]}>Projects</a>
            <a href="/team" class={[section === "team" && "is-active"]}>Team</a>
          </nav>
        </div>
        <div class="app-shell-user row gap-3">
          <span class="app-shell-name">{user.name}</span>
          <span e:if={user.role === "admin"} class="pill is-accent">Admin</span>
          <button class="is-ghost is-sm" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>
    <main class="app-main app-shell-main">
      <slot/>
    </main>
  </div>
</AppShell>
