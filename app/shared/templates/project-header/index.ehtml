import "./style.css";
import { Project } from "#app/shared/services/tracker";

<ProjectHeader (project: Project, tab: string, isAdmin: boolean)>
  <div class="project-header stack is-sm">
    <div class="project-header-top row">
      <div class="row gap-2">
        <span class="pill project-header-key">{project.key}</span>
        <h1 class="text-2xl">{project.name}</h1>
      </div>
      <div class="row gap-2">
        <slot/>
      </div>
    </div>
    <nav class="tab-list" aria-label="Project views">
      <a class={["tab", tab === "board" && "is-active"]} href={`/projects/${project.key}`}>Board</a>
      <a class={["tab", tab === "list" && "is-active"]} href={`/projects/${project.key}/issues`}>List</a>
      <a e:if={isAdmin} class={["tab", tab === "import" && "is-active"]} href={`/projects/${project.key}/import`}>Import</a>
    </nav>
  </div>
</ProjectHeader>
