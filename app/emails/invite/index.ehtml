import "./style.css";

/**
 * The invitation link. It sets the invitee's password and signs them in.
 *
 * @email
 */
<html (inviterName: string, role: string, url: string)>
  <body class="email invite">
    <div class="email-wrap">
      <h1>Join your team on tickwell</h1>
      <p>{inviterName} invited you to tickwell as {role === "admin" ? "an admin" : "a member"}.</p>
      <p><a class="cta" href={url}>Set your password</a></p>
      <div class="email-footer">
        <p>The link works once and expires in 7 days. If you did not expect it, ignore this email.</p>
      </div>
    </div>
  </body>
</html>
